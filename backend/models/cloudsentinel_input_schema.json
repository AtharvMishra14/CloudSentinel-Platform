{
  "application": "CloudSentinel",
  "model_name": "AISAPSO-inspired LightGBM",
  "input_format": "One row per case, with all numerical feature columns listed below and a log_text column.",
  "feature_columns": [
    "cpu_usage_mean",
    "cpu_usage_median",
    "cpu_usage_std",
    "cpu_usage_min",
    "cpu_usage_max",
    "cpu_usage_q10",
    "cpu_usage_q90",
    "mem_usage_mean",
    "mem_usage_median",
    "mem_usage_std",
    "mem_usage_min",
    "mem_usage_max",
    "mem_usage_q10",
    "mem_usage_q90",
    "disk_io_mean",
    "disk_io_median",
    "disk_io_std",
    "disk_io_min",
    "disk_io_max",
    "disk_io_q10",
    "disk_io_q90",
    "net_in_mean",
    "net_in_median",
    "net_in_std",
    "net_in_min",
    "net_in_max",
    "net_in_q10",
    "net_in_q90",
    "net_out_mean",
    "net_out_median",
    "net_out_std",
    "net_out_min",
    "net_out_max",
